APP_NAME="JLPT CBT"
APP_BRAND="LPK Jakaruta Global Group"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Tombol "Demo masuk cepat" di halaman login (masuk tanpa password). Hanya untuk uji coba; biarkan false di situs sungguhan.
DEMO_LOGIN=false

# Dua domain, satu aplikasi & database. LMS: siswa, sensei, staf. Tes: peserta tes umum (role test_taker).
# Kosongkan PORTAL_TEST_HOST untuk mematikan pemisahan. SESSION_DOMAIN harus null agar login per domain terpisah.
PORTAL_LMS_HOST=
PORTAL_TEST_HOST=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jlpt_cbt
DB_USERNAME=root
DB_PASSWORD=

# Database lama, hanya untuk php artisan legacy:import
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=jlpt_jgg
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=
# Folder public/pdf milik aplikasi lama (file .html yang isinya PDF)
LEGACY_PDF_PATH=/var/www/rpl/laravel/public/pdf
# Folder audio choukai lama (file .mp3 yang namanya ada di jwb_soal.flag1); subfolder ikut dicari
LEGACY_AUDIO_PATH=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Midtrans (Settings → Access Keys di dashboard Midtrans). Sandbox dulu, lalu production.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_EXPIRY_MINUTES=60
